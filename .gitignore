# =============================================================================
# recon-ai-suite - Reglas de exclusión de Git
# =============================================================================

# --- Entornos virtuales ------------------------------------------------------
.venv/
venv/
env/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Evidencia generada (se conservan los .gitkeep) --------------------------
evidencia/raw/*
evidencia/parsed/*
evidencia/reportes/*
!evidencia/**/.gitkeep

# --- Wordlists ----------------------------------------------------------------
# SÍ se versiona (~38 KB): el repo funciona out-of-the-box al clonar y queda
# congelada la versión de SecLists que fue probada.

# --- Secretos -----------------------------------------------------------------
.env
*.key
config.local.yaml

# --- Sistema operativo --------------------------------------------------------
.DS_Store
Thumbs.db

# Excepciones: versionar solo el entregable final y el JSON priorizado
!evidencia/reportes/*.md
!evidencia/parsed/*_priorizado.json
.coverage
.coverage.*
htmlcov/
